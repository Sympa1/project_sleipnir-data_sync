# Beispiel .env für lokale Entwicklung (nicht in Git committen)
# Benutze diese Datei als Vorlage und kopiere sie zu ".env" im Projektstamm.

# PostgreSQL Verbindungsparameter
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change_me

# Optional: vollständiger ConnectionString statt Einzelwerte
# CONNECTION_STRING=Host=localhost;Port=5432;Database=data_sync;Username=postgres;Password=change_me

